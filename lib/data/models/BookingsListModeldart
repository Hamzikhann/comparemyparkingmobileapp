class BookingResponse {
  final List<Parking> reservedParkings;
  final List<Parking> pendingParkings;
  final List<Parking> completedParkings;

  BookingResponse({
    required this.reservedParkings,
    required this.pendingParkings,
    required this.completedParkings,
  });

  factory BookingResponse.fromJson(Map<String, dynamic> json) {
    return BookingResponse(
      reservedParkings: (json['reservedParkings'] as List)
          .map((data) => Parking.fromJson(data))
          .toList(),
      pendingParkings: (json['pendingParkings'] as List)
          .map((data) => Parking.fromJson(data))
          .toList(),
      completedParkings: (json['completedParkings'] as List)
          .map((data) => Parking.fromJson(data))
          .toList(),
    );
  }
}

class Parking {
  final String id;
  final String startDate;
  final String endDate;
  final String startTime;
  final String endTime;
  final String airport;
  final String? promoCode;  // Nullable
  final String status;     // Nullable
  final String isActive;
  final String createdAt;
  final String updatedAt;
  final String userId;
  final String? guestUserId;  // Nullable
  final String packageId;
  final List<Registration> registrations;
  final List<Vehicle> vehicles;

  Parking({
    required this.id,
    required this.startDate,
    required this.endDate,
    required this.startTime,
    required this.endTime,
    required this.airport,
    this.promoCode,        // Nullable
    required this.status,           // Nullable
    required this.isActive,
    required this.createdAt,
    required this.updatedAt,
    required this.userId,
    this.guestUserId,      // Nullable
    required this.packageId,
    required this.registrations,
    required this.vehicles,
  });

  factory Parking.fromJson(Map<String, dynamic> json) {
    return Parking(
      id: json['id'],
      startDate: json['startDate'],
      endDate: json['endDate'],
      startTime: json['startTime'] ?? "",  // Default empty string if null
      endTime: json['endTime'] ?? "",      // Default empty string if null
      airport: json['airport'],
      promoCode: json['promoCode'],        // Nullable
      status: json['status'],              // Nullable
      isActive: json['isActive'],
      createdAt: json['createdAt'],
      updatedAt: json['updatedAt'],
      userId: json['userId'],
      guestUserId: json['guestUserId'],    // Nullable
      packageId: json['packageId'],
      registrations: (json['registrations'] as List)
          .map((data) => Registration.fromJson(data))
          .toList(),
      vehicles: (json['vehicles'] as List)
          .map((data) => Vehicle.fromJson(data))
          .toList(),
    );
  }
}



